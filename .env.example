KEYCAFE_EMAIL=name@example.com
KEYCAFE_TOKEN=replace-with-keycafe-api-token
# Use "key" for an API key created in the Keycafe web UI; default is "token".
KEYCAFE_AUTH_MODE=token
KEYCAFE_USER_AGENT=KeycafeTableau/0.1 (+https://docs.keycafe.com/reference/api-overview)

# Use deterministic local data without Keycafe credentials or network requests.
# Demo mode takes precedence when real credentials are also configured.
# KEYCAFE_DEMO_MODE=true

# Authentication is handled at the reverse proxy.
# Protect the entire app, including /api/, and do not expose Django directly.
DJANGO_DEBUG=false
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=replace-with-a-random-secret
# Include the public hostname and 127.0.0.1 for the container health check.
DJANGO_ALLOWED_HOSTS=tableau.example.org,localhost,127.0.0.1
TABLEAU_PORT=8000

# Public HTTPS origin for CSRF validation behind a TLS-terminating proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=https://tableau.example.org
# Local development default: data/groups.sqlite3; Docker uses /data/groups.sqlite3.
# TABLEAU_GROUPS_DB=/absolute/path/to/groups.sqlite3

# Shared upstream cache and request budget (all workers must share this path).
KEYCAFE_CACHE_SECONDS=60
KEYCAFE_REQUESTS_PER_MINUTE=50
# TABLEAU_UPSTREAM_DB=/absolute/path/to/upstream.sqlite3

# Required for image-only deployment with compose.deploy.yaml.
# Set this after the corresponding vX.Y.Z release workflow has succeeded.
# TABLEAU_IMAGE=ghcr.io/levinuss/keycafe-tableau:0.1.0
